# ---- Core ----
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=https://ai.sumitgroups.com
BACKEND_URL=https://ai.sumitgroups.com/api
NEXT_PUBLIC_API_URL=https://ai.sumitgroups.com/api/v1

# ---- Database (MySQL 8) ----
DATABASE_URL=mysql+aiomysql://ai_saas:changeme@mysql:3306/ai_saas?charset=utf8mb4
MYSQL_USER=ai_saas
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=ai_saas

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Auth ----
JWT_SECRET=change_this_to_a_random_64_char_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI Providers ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- Payments ----
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=      # reserved for future PaymentProvider implementation
# STRIPE_WEBHOOK_SECRET=

# ---- Storage ----
STORAGE_PATH=/app/storage
MAX_UPLOAD_MB=10
MAX_IMAGE_DIMENSION=4096
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,webp

# ---- Email ----
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sumitgroups.com

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=INFO

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
